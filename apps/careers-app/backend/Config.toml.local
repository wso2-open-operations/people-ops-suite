[careers_app]
allowedOrigins = [""]
port = 8080

[careers_app.vacancy.atsConfig]
baseUrl = ""
tokenUrl = ""
clientId = ""
clientSecret = ""

[careers_app.jwt.authConfig]
jwksUrl = ""
issuer = ""
audience = ""
userInfoUrl = ""

# Onboarding documents storage; the SAS token needs create, write and read permission.
[careers_app.documents.storageConfig]
baseUrl = ""
container = ""
sasToken = ""

# Optional: when submissions stop being editable (ISO 8601 with offset); empty means never editable.
# [careers_app.documents]
# submissionDeadline = ""

# Optional: limit on the requests of one signed-in user.
# [careers_app.apply]
# signedInMaxPerUser = 60
# signedInWindowSeconds = 60

# Optional: job read cache, in seconds.
# [careers_app.vacancy]
# refreshAfterSeconds = 120
# maxStaleSeconds = 21600
# failFastSeconds = 5